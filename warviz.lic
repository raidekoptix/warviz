#QUIET
=begin

	Warlock integration of Visualizer.lic with some additional ambient niceties

	  To start: ;warviz
	   To stop: ;warviz stop

            author: Raidek (git@raidek.tv)
   original author: Visualizer.lic by Selfane, Tysong (art by Alosaka, Oro)
              game: any
           version: 1.1.0
          required: Lich >= 5.17.0, Warlock >=3.0.167

   changelog:
      1.1.0 (2026-05-07)
        - Switched to standard room_id (.uid.max had a huge performance hit)
        - Translated uid images to id (kept uid for compatibility for now)
        - Reworked directory structure for multiple game support
      1.0.0 (2026-05-05)
        Initial release
=end

# Lich directives
no_kill_all
no_pause_all
hide_me
silence_me

supernodes = [ 156,188,194,228,288,318,477,601,638,728,1005,1259,1263,1438,1481,1572,1844,1932,2300,2400,2777,3365,3428,3449,3486,3519,3542,3544,3600,3668,3735,3807,3880,4653,5732,5751,7986,8754,8859,9242,10068,10374,10855,10861,12537,13362,13920,13942,14029,14234,14627,16001,16183,17587,17589,18258,18687,18850,19290,20695,20707,20713,20721,20734,20762,20770,20777,20869,21310,21330,21689,21749,22118,23211,24433,24473,24555,26841,26947,26954,26969,26972,27840,28709,28717,28718,28719,28742,28813,28916,28937,28950,28990,29623,30276,31122,36157 ]
minecarts = [ 1005, 19547 ]

downstream_hook_id = "#{Script.current.name}"
gameroot = File.join(SCRIPT_DIR, "img.#{Script.current.name}", XMLData.game)
genroot = File.join(SCRIPT_DIR, "img.#{Script.current.name}", "generic")
mineroot = File.join(gameroot, "minecart")

styles = {
	'main' => "align='right' mode='gradient' start='0' end='30' opacity='80'",
	'room' => "mode='full' align='right' valign='bottom' opacity='80'",
	'dead' => "mode='fill' opacity='80' img=\"#{File.join(genroot, 'dead.png')}\""
}

downstream_proc = proc { |line, _server_string|
  newline = nil
  if checkdead == true
    newline = "<background window='room'/><background window='main' #{styles['dead']}/>#{line}"
  elsif minecarts.include?(Room.current.id)
    current_image = "#{$1}.png" if /(Amazingly the cart stays) on the track as it takes a sharp turn to the right./ =~ line
    current_image = "#{$1}.png" if /(As the cart careens) uncontrollably down the track, the rushing wind bellows and howls./ =~ line
    current_image = "#{$1}.png" if /(Careening along the track) at incredible speed, the cart lurches suddenly as the track runs out, flying across empty space and crashing down a few feet later as the track begins again on the other side of the fissure, slowing only slightly./ =~ line
    current_image = "#{$1}.png" if /(Glowing blue moss) covers the rock walls in this section of the tunnel.  Dampness permeates the area./ =~ line
    current_image = "#{$1}.png" if /(Hitting a slightly decayed length of wood) lying sideways across the track, the cart lurches upward splintering the wood into a thousand pieces, connecting with the track again with a jolt./ =~ line
    current_image = "#{$1}.png" if /(Leaning against the rough rock walls), the skeletal remains of a humanoid can be seen as though relaxing after a hard day's labor on the tracks, pickaxe still clutched firmly in its bony hands./ =~ line
    current_image = "#{$1}.png" if /(Loud dripping sounds echo) from diverging tunnels as the cart continues its journey./ =~ line
    current_image = "#{$1}.png" if /(Plunging downward) at amazing speed the cart suddenly rises, looping in a full circle before leveling out again./ =~ line
    current_image = "#{$1}.png" if /(Proceeding at astonishing speed), the cart suddenly plunges into a lightless tunnel./ =~ line
    current_image = "#{$1}.png" if /(Rocks and debris fall) into the deep gorge at the cart's passing as it speeds headlong into a darkened tunnel./ =~ line
    current_image = "#{$1}.png" if /(Rounding a curve the cart tilts) to one side as two of its wheels leave the track for a few heart-stopping moments./ =~ line
    current_image = "#{$1}.png" if /(Shuddering noticeably), the cart begins its journey, moving forward over a slight rise in the track before plunging downward picking up speed./ =~ line
    current_image = "#{$1}.png" if /(The cart jolts suddenly to the left) as it careens around the corner at breakneck speed./ =~ line
    current_image = "#{$1}.png" if /(The cart rocks precariously) as it speeds along the track across a deep gorge./ =~ line
    current_image = "#{$1}.png" if /(The cart slows a bit) as it begins to rise upward along the tracks, clanking loudly.  Sapphires, diamonds, and rubies imbedded in the stone walls of the tunnel sparkle brightly as stray beams of light strike them./ =~ line
    current_image = "#{$1}.png" if /(The clanking noise of the cart) gliding along the track echoes loudly as it moves through a large cavern./ =~ line
    current_image = "#{$1}.png" if /(The clanking of the cart echoes) through the tunnel as it slows steadily before suddenly plunging down a steep embankment./ =~ line
    current_image = "#{$1}.png" if /(The wind howls loudly) as the cart careens uncontrollably down the track./ =~ line
    current_image = "#{$1}.png" if /(You hastily exit) the cart./ =~ line
    newline = "<background window='main' #{styles['main']} img=\"#{current_image}\"/>"
  elsif line =~ /(<nav rm='\d+'.*)/ && checkdead == false
    current_image = File.join(gameroot, "id", "#{Room.current.id}.png")
#    unless File.exist?(current_image)
#      current_image = File.join(gameroot, "uid", "u#{Room.current.uid.max}.png")
#    end
    unless File.exist?(current_image)
      current_image = File.join(gameroot, "location", "#{Room.current.location}.png")
    end
    if supernodes.include?(Room.current.id)
      sntag = "<background window='room' #{styles['room']} img=\"#{File.join(genroot, 'supernode.png')}\"/>"
    else
      sntag = "<background window='room'/>"
    end
    bgtag = "<background window='main' #{styles['main']} img=\"#{current_image}\"/>"
    newline = "#{sntag}#{bgtag}"
  end
  if newline
    newline + line
  else
    line
  end
}

if Script.current.vars[1] =~ /^stop/i
  if DownstreamHook.list.include?(downstream_hook_id)
    DownstreamHook.remove(downstream_hook_id)
    respond "--- Lich: #{Script.current.name} service stopped\n"
  else
    respond "--- Lich: #{Script.current.name} service is not running\n"
  end
  exit
else
  if DownstreamHook.list.include?(downstream_hook_id)
    respond "--- Lich: #{Script.current.name} service already running\n"
  else
    DownstreamHook.add(downstream_hook_id, downstream_proc)
    respond "--- Lich: #{Script.current.name} service started\n"
  end
end

if checkdead == true
  initline = "<background window='room'/><background window='main' #{styles['dead']} img=\"#{File.join(genroot, 'dead.png')}\"/>"
else
  current_image = File.join(gameroot, "id", "#{Room.current.id}.png")
#  unless File.exist?(current_image)
#    current_image = File.join(gameroot, "uid", "#{Room.current.uid.max}.png")
#  end
  unless File.exist?(current_image)
    current_image = File.join(gameroot, "location", "#{Room.current.location}.png")
  end
  initline = "<background window='main' #{styles['main']} img=\"#{current_image}\"/>"
  if supernodes.include?(Room.current.id)
    sntag = "<background window='room' #{styles['room']} img=\"#{File.join(genroot, 'supernode.png')}\"/>"
  end
end

puts sntag
puts initline
